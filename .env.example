# Kopieren nach .env und ausfüllen. Die .env NIE einchecken.

# Schlüssel für das Anlegen von Nutzern (POST /admin/users). Beliebiger langer Zufallswert.
ADMIN_KEY=bitte-lange-zufallszeichenfolge-eintragen

# Dein Claude-API-Key aus der Anthropic Console
ANTHROPIC_API_KEY=

# Modell für die Plan-Erstellung (in der Console prüfen, ob die ID verfügbar ist)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Sparsamkeit: KI-Aufrufe pro Nutzer (ein Plan = 1 Aufruf, bei Fehlversuch bis zu 2)
AI_MAX_CALLS_PER_DAY=4
AI_MAX_CALLS_PER_MONTH=8

# Obergrenze für die Ausgabelänge eines Plans
PLAN_MAX_TOKENS=32000

# Denkaufwand der KI (low, medium, high). Weniger = schneller und günstiger, Thinking zählt in PLAN_MAX_TOKENS
PLAN_EFFORT=medium

# Nur für lokalen Betrieb ohne Docker relevant (docker-compose überschreibt das)
MONGO_CONNECTION=mongodb://localhost:27017
MONGO_DB=hyroxcoach
# Coach-Chat: Nachrichten pro Tag und Nutzer (zählt nicht zum Planlimit)
AI_MAX_CHAT_PER_DAY=40

# Nur Produktion (VPS): Domain, unter der die API per HTTPS erreichbar ist, z.B. api.example.de
DOMAIN=
