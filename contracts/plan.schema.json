{
  "type": "object",
  "description": "Trainingsplan für 2 bis 4 Wochen. Jede Woche hat genau 7 Tage, lückenlos ab startDate.",
  "required": ["title", "summary", "focus", "startDate", "weeks"],
  "properties": {
    "title": { "type": "string", "description": "Kurzer Titel des Plans" },
    "summary": { "type": "string", "description": "2-4 Sätze: Aufbau und Begründung des Plans" },
    "focus": {
      "type": "object",
      "required": ["primary", "rationale"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      }
    },
    "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["weekNumber", "theme", "days"],
        "properties": {
          "weekNumber": { "type": "integer", "minimum": 1 },
          "theme": { "type": "string" },
          "days": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "object",
              "required": ["date", "dayType", "title", "durationMin", "variants"],
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "dayType": {
                  "type": "string",
                  "enum": ["run", "strength", "hyrox_sim", "mixed", "recovery", "rest"]
                },
                "title": { "type": "string" },
                "intent": { "type": "string" },
                "durationMin": { "type": "integer", "minimum": 0 },
                "variants": {
                  "type": "array",
                  "description": "Leer bei Ruhetagen. Sonst je Ort eine Variante (gym und/oder home).",
                  "items": {
                    "type": "object",
                    "required": ["location", "blocks"],
                    "properties": {
                      "location": { "type": "string", "enum": ["gym", "home"] },
                      "blocks": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["name", "type", "exercises"],
                          "properties": {
                            "name": { "type": "string" },
                            "type": {
                              "type": "string",
                              "enum": ["warmup", "main", "finisher", "cooldown"]
                            },
                            "format": {
                              "type": "string",
                              "enum": ["straight_sets", "circuit", "emom", "amrap", "intervals", "steady", "for_time"]
                            },
                            "rounds": { "type": "integer", "minimum": 1 },
                            "notes": { "type": "string" },
                            "exercises": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "required": ["name"],
                                "properties": {
                                  "name": { "type": "string" },
                                  "station": {
                                    "type": "string",
                                    "enum": [
                                      "run", "skierg", "sled_push", "sled_pull", "burpee_broad_jump",
                                      "rowing", "farmers_carry", "sandbag_lunges", "wall_balls"
                                    ]
                                  },
                                  "sets": { "type": "integer", "minimum": 1 },
                                  "reps": { "type": "integer", "minimum": 1 },
                                  "distanceM": { "type": "number", "minimum": 0 },
                                  "durationSec": { "type": "integer", "minimum": 0 },
                                  "loadKg": { "type": "number", "minimum": 0 },
                                  "loadNote": { "type": "string" },
                                  "restSec": { "type": "integer", "minimum": 0 },
                                  "targetPace": { "type": "string" },
                                  "rpeTarget": { "type": "number", "minimum": 1, "maximum": 10 },
                                  "equipment": { "type": "array", "items": { "type": "string" } },
                                  "notes": { "type": "string" }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
